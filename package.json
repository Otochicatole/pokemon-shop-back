{
  "name": "back-card-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "admin:otp": "tsx src/cli/admin-otp.ts",
    "admin:create": "tsx src/cli/create-admin.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "mercadopago": "3.5.0",
    "multer": "2.2.0",
    "nodemailer": "9.0.5",
    "openid-client": "6.8.7",
    "otpauth": "9.5.1",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "sharp": "0.35.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/multer": "2.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/node": "24.3.0",
    "@types/pino-http": "5.8.4",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/parser": "8.68.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.35.0",
    "pino-pretty": "13.1.2",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
