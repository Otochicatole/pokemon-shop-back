NODE_ENV=development
PORT=3000
DATABASE_URL="file:../storage/db/card-shop.db"
STORAGE_ROOT=./storage
FRONTEND_ORIGINS=http://localhost:3001
# Production: FRONTEND_ORIGINS=https://nevadatcg.store
COOKIE_SECURE=false
# Production (HTTPS): COOKIE_SECURE=true and NODE_ENV=production
SWAGGER_ENABLED=true
SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console. If the API is on a subdomain, use that host
# and set NEXT_PUBLIC_API_URL on the front to the same origin (cookies are host-only).
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v2/auth/google/callback
# Production: GOOGLE_REDIRECT_URI=https://api.nevadatcg.store/api/v2/auth/google/callback
PUBLIC_API_URL=http://localhost:3000
# Production: PUBLIC_API_URL=https://api.nevadatcg.store
PUBLIC_WEB_URL=http://localhost:3001
# Production: PUBLIC_WEB_URL=https://nevadatcg.store
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
DOLARAPI_URL=https://dolarapi.com/v1/dolares/blue
DOLARAPI_TIMEOUT_MS=3000
DOLARAPI_CACHE_TTL_SECONDS=1800
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SEED_ADMIN_EMAIL=admin@cardshop.test
SEED_ADMIN_PASSWORD=Admin123!seed-card-shop
SEED_USER_EMAIL=user@cardshop.test
SEED_USER_PASSWORD=User123!seed-card-shop
