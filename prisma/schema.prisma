generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductKind {
  SINGLE_CARD
  SEALED_PRODUCT
  ACCESSORY
}

enum PokemonType {
  COLORLESS
  DARKNESS
  DRAGON
  FAIRY
  FIGHTING
  FIRE
  GRASS
  LIGHTNING
  METAL
  PSYCHIC
  WATER
}

enum StockMode {
  UNIQUE
  QUANTITY
}

enum ProductCondition {
  NM
  EXCELLENT
  GOOD
  PLAYED
  DAMAGED
}

enum FulfillmentType {
  SHIPMENT
  PICKUP
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  IN_FULFILLMENT
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  PARTIALLY_COMPLETED
  ACTION_REQUIRED
  COMPLETED
  CANCELLED
  EXPIRED
  REFUND_RECORDED
  PAYMENT_REQUIRES_REVIEW
}

enum PaymentMethod {
  BANK_TRANSFER
  MERCADO_PAGO
}

enum MercadoPagoIntegrationMode {
  PREFERENCE_V1
  ORDER_V1
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PARTIALLY_REFUNDED
  REJECTED
  FAILED
  REFUNDED
  DISPUTED
  REQUIRES_REVIEW
}

enum TransferReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum FileCleanupStatus {
  PENDING
  PROCESSING
  QUARANTINED
  RETAINED
  COMPLETED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EARN_REVERSAL
  REDEEM_REVERSAL
  ADJUSTMENT
}

enum LoyaltyRedemptionStatus {
  NONE
  RESERVED
  REDEEMED
  RELEASED
  RESTORED
}

enum SupportConversationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportActorType {
  USER
  ADMIN
}

enum NotificationRecipientType {
  USER
  ADMIN
}

enum NotificationType {
  SUPPORT_MESSAGE
  ORDER_STATUS_CHANGED
  ORDER_CREATED
  TRANSFER_RECEIPT_SUBMITTED
  PAYMENT_REQUIRES_REVIEW
  PAYMENT_APPROVED
  AFFILIATE_LISTING_SUBMITTED
  AFFILIATE_LISTING_REVIEWED
  AFFILIATE_ORDER_CREATED
  AFFILIATE_ORDER_STATUS_CHANGED
  AFFILIATE_ISSUE_OPENED
  AFFILIATE_CANCELLATION_REQUESTED
  AFFILIATE_CANCELLATION_UPDATED
  AFFILIATE_PAYOUT_REQUESTED
  AFFILIATE_PAYOUT_UPDATED
}

enum AffiliateStatus {
  ACTIVE
  SUSPENDED
}

enum AffiliateListingStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  REJECTED
  APPROVED
}

enum SellerType {
  STORE
  AFFILIATE
}

enum SellerOrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  SHIPPED
  COMPLETED
  CANCELLATION_REQUESTED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum AffiliateLedgerBucket {
  PENDING
  AVAILABLE
  RESERVED
  PAID
}

enum AffiliateLedgerType {
  SALE_PENDING
  SALE_RELEASED
  SALE_REVERSED
  PAYOUT_RESERVED
  PAYOUT_PAID
  PAYOUT_RELEASED
  ADJUSTMENT
}

enum AffiliatePayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

enum AffiliateIssueStatus {
  OPEN
  RESOLVED_CONTINUED
  RESOLVED_COMPLETED
  RESOLVED_PARTIAL_REFUND
  RESOLVED_FULL_REFUND
  RESOLVED_REFUNDED
}

enum AffiliateCancellationStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  name                 String?
  passwordHash         String?
  status               UserStatus            @default(ACTIVE)
  emailVerifiedAt      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  oauthAccounts        UserOAuthAccount[]
  sessions             UserSession[]
  tokens               UserToken[]
  orders               Order[]
  outboxMessages       OutboxMessage[]
  loyaltyAccount       LoyaltyAccount?
  loyaltyTransactions  LoyaltyTransaction[]
  supportConversations SupportConversation[]
  notifications        Notification[]       @relation("UserNotifications")
  affiliate            Affiliate?
  affiliateIssues      AffiliateIssue[]
}

model UserOAuthAccount {
  id           String   @id @default(uuid())
  userId       String
  issuer       String
  subject      String
  emailAtLogin String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  csrfHash   String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipHash     String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model UserToken {
  id        String        @id @default(uuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Admin {
  id                    String                @id @default(uuid())
  email                 String                @unique
  name                  String?
  passwordHash          String
  status                AdminStatus           @default(ACTIVE)
  totpSecretCipher      String?
  totpEnabledAt         DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  sessions              AdminSession[]
  recoveryCodes         AdminRecoveryCode[]
  productImages         ProductImage[]
  inventoryChanges      InventoryAdjustment[]
  orderHistory          OrderStatusHistory[]
  transferReviews       TransferReceipt[]
  refunds               RefundRecord[]
  bankTransfers         BankTransfer[]
  loyaltyProgramUpdates LoyaltyProgram[]
  transferSettingsUpdates TransferSettings[]
  notifications         Notification[]      @relation("AdminNotifications")
  affiliateReviews      AffiliateListing[]  @relation("AffiliateListingReviews")
  affiliatePayouts      AffiliatePayoutRequest[] @relation("AffiliatePayoutProcessors")
  affiliateIssueResolutions AffiliateIssue[] @relation("AffiliateIssueResolutions")
  affiliateCancellationResolutions AffiliateCancellationRequest[] @relation("AffiliateCancellationResolutions")
  affiliateProgramUpdates AffiliateProgramSettings[]
  supplierPurchases     SupplierPurchase[]
}

model LoyaltyProgram {
  id                       String   @id @default("default")
  enabled                  Boolean  @default(true)
  currency                 String   @default("USD")
  spendPerPointMinor       BigInt   @default(100)
  pointsPerStep            Int      @default(1)
  pointValueMinor          BigInt   @default(1)
  minimumRedemptionPoints  Int      @default(1)
  maximumRedemptionPercent Int      @default(50)
  version                  Int      @default(1)
  updatedById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  updatedBy                Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model TransferSettings {
  id          String   @id @default("default")
  enabled     Boolean  @default(false)
  bankName    String   @default("")
  accountHolder String @default("")
  cbu         String?
  alias       String?
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model LoyaltyAccount {
  id               String               @id @default(uuid())
  userId           String               @unique
  balance          Int                  @default(0)
  reserved         Int                  @default(0)
  lifetimeEarned   Int                  @default(0)
  lifetimeRedeemed Int                  @default(0)
  version          Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id           String                 @id @default(uuid())
  accountId    String
  userId       String
  orderId      String?
  type         LoyaltyTransactionType
  points       Int
  balanceAfter Int
  description  String?
  createdAt    DateTime               @default(now())
  account      LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orderId, type])
  @@index([accountId, createdAt])
  @@index([userId, createdAt])
}

model AdminSession {
  id         String    @id @default(uuid())
  adminId    String
  tokenHash  String    @unique
  csrfHash   String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipHash     String?
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt])
  @@index([expiresAt])
}

model AdminRecoveryCode {
  id        String    @id @default(uuid())
  adminId   String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, usedAt])
}

model Supplier {
  id          String             @id @default(uuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  active      Boolean            @default(true)
  version     Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  purchases   SupplierPurchase[]

  @@index([active, name])
  @@index([updatedAt])
}

model SupplierPurchase {
  id          String                 @id @default(uuid())
  supplierId  String
  purchasedAt DateTime
  note        String?
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  supplier    Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy   Admin?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       SupplierPurchaseItem[]

  @@index([supplierId, purchasedAt])
  @@index([createdById])
}

model SupplierPurchaseItem {
  id             String           @id @default(uuid())
  purchaseId     String
  productId      String?
  productSku     String
  productName    String
  quantity       Int
  unitCostMinor  BigInt
  currency       String           @default("USD")
  lineTotalMinor BigInt
  purchase       SupplierPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
}

model Affiliate {
  id                    String                @id @default(uuid())
  userId                String                @unique
  publicName            String
  contactPhone          String?
  payoutAccountCipher   String?
  payoutAccountLast4    String?
  commissionBpsOverride  Int?
  status                AffiliateStatus       @default(ACTIVE)
  version               Int                   @default(1)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings              AffiliateListing[]
  products              Product[]
  shippingZones         ShippingZone[]
  pickupPoints          PickupPoint[]
  sellerOrders          SellerOrder[]
  ledgerEntries         AffiliateLedgerEntry[]
  payoutRequests        AffiliatePayoutRequest[]
  issues                AffiliateIssue[]
  cancellationRequests  AffiliateCancellationRequest[]
  imageUploads          ProductImage[]
  inventoryChanges      InventoryAdjustment[]

  @@index([status, publicName])
  @@index([updatedAt])
}

model AffiliateProgramSettings {
  id             String   @id @default("default")
  commissionBps  Int      @default(1000)
  autoCompleteDays Int    @default(7)
  version        Int      @default(1)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model AffiliateListing {
  id            String                 @id @default(uuid())
  productId     String                 @unique
  affiliateId   String
  status        AffiliateListingStatus @default(DRAFT)
  reviewNote    String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  affiliate     Affiliate              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  notifications Notification[]
  reviewedBy    Admin?                 @relation("AffiliateListingReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([affiliateId, status, updatedAt])
  @@index([status, submittedAt])
}

model Product {
  id            String                 @id @default(uuid())
  sku           String                 @unique
  slug          String                 @unique
  name          String
  description   String
  kind          ProductKind
  stockMode     StockMode
  priceMinor    BigInt
  currency      String                 @default("USD")
  status        ProductStatus          @default(DRAFT)
  version       Int                    @default(1)
  publishedAt   DateTime?
  archivedAt    DateTime?
  affiliateId   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  pokemonCard   PokemonCardDetails?
  inventory     Inventory?
  images        ProductImage[]
  orderItems    OrderItem[]
  inventoryLogs InventoryAdjustment[]
  reservations  InventoryReservation[]
  supplierPurchaseItems SupplierPurchaseItem[]
  affiliate     Affiliate?              @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  affiliateListing AffiliateListing?

  @@index([status, kind])
  @@index([status, priceMinor])
  @@index([status, publishedAt])
  @@index([updatedAt])
  @@index([affiliateId, status])
}

model PokemonCardDetails {
  id                  String           @id @default(uuid())
  productId           String           @unique
  pokemonType         PokemonType?
  setName             String
  setCode             String?
  cardNumber          String
  rarity              String
  language            String
  condition           ProductCondition
  finish              String?
  edition             String?
  gradingCompany      String?
  grade               String?
  certificationNumber String?
  product             Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([setName, cardNumber])
  @@index([setCode])
  @@index([rarity, condition])
  @@index([condition])
  @@index([pokemonType])
  @@index([language])
  @@index([finish])
  @@index([edition])
  @@index([gradingCompany])
}

model Inventory {
  id        String  @id @default(uuid())
  productId String  @unique
  onHand    Int     @default(0)
  reserved  Int     @default(0)
  version   Int     @default(1)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id          String     @id @default(uuid())
  productId   String
  fileId      String     @unique
  altText     String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  retiredAt   DateTime?
  createdById String?
  createdByAffiliateId String?
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  file        StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy   Admin?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByAffiliate Affiliate? @relation(fields: [createdByAffiliateId], references: [id], onDelete: SetNull)

  @@index([productId, retiredAt, sortOrder])
}

model ShippingZone {
  id        String                 @id @default(uuid())
  name      String
  active    Boolean                @default(true)
  provinces ShippingZoneProvince[]
  rates     ShippingRate[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([active, name])
  @@index([affiliateId, active, name])
}

model ShippingZoneProvince {
  id       String       @id @default(uuid())
  zoneId   String
  province String
  zone     ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, province])
  @@index([province])
}

model ShippingRate {
  id         String       @id @default(uuid())
  zoneId     String
  name       String
  priceMinor BigInt
  currency   String       @default("USD")
  active     Boolean      @default(true)
  zone       ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, active])
}

model PickupPoint {
  id        String   @id @default(uuid())
  name      String
  address   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([active, name])
  @@index([affiliateId, active, name])
}

model Order {
  id                        String                  @id @default(uuid())
  userId                    String
  number                    String                  @unique
  status                    OrderStatus             @default(PENDING_PAYMENT)
  version                   Int                     @default(1)
  paymentMethod             PaymentMethod
  fulfillmentType           FulfillmentType
  currency                  String                  @default("USD")
  subtotalMinor             BigInt
  shippingMinor             BigInt
  totalMinor                BigInt
  loyaltyProgramVersion     Int?
  loyaltySpendPerPointMinor BigInt?
  loyaltyPointValueMinor    BigInt?
  pointsRedeemed            Int                     @default(0)
  pointsDiscountMinor       BigInt                  @default(0)
  pointsEarned              Int                     @default(0)
  loyaltyRedemptionStatus   LoyaltyRedemptionStatus @default(NONE)
  shippingRateId            String?
  pickupPointId             String?
  shippingZoneName          String?
  shippingRateName          String?
  shippingRatePriceMinor    BigInt?
  pickupPointName           String?
  pickupPointAddress        String?
  recipientName             String?
  recipientPhone            String?
  addressLine1              String?
  addressLine2              String?
  city                      String?
  province                  String?
  postalCode                String?
  idempotencyKey            String
  idempotencyHash           String
  expiresAt                 DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                     OrderItem[]
  reservations              InventoryReservation[]
  payment                   Payment?
  statusHistory             OrderStatusHistory[]
  transferReceipts          TransferReceipt[]
  outboxMessages            OutboxMessage[]
  loyaltyTransactions       LoyaltyTransaction[]
  notifications              Notification[]
  sellerOrders              SellerOrder[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@index([paymentMethod, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  sellerOrderId   String?
  productId       String?
  sku             String
  productName     String
  productSnapshot String
  imageFileId     String?
  unitPriceMinor  BigInt
  quantity        Int
  lineTotalMinor  BigInt
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder     SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  refundLines     RefundLine[]

  @@index([orderId])
  @@index([imageFileId])
  @@index([sellerOrderId])
  @@index([productId])
}

model InventoryReservation {
  id         String    @id @default(uuid())
  orderId    String
  sellerOrderId String?
  productId  String
  quantity   Int
  expiresAt  DateTime
  releasedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([expiresAt, releasedAt, consumedAt])
  @@index([sellerOrderId])
}

model SellerOrder {
  id                     String            @id @default(uuid())
  orderId                String
  number                 String            @unique
  sellerType             SellerType
  affiliateId            String?
  sellerName             String            
  sellerContactPhone     String?
  status                 SellerOrderStatus @default(PENDING_PAYMENT)
  version                Int               @default(1)
  subtotalMinor          BigInt
  shippingMinor          BigInt
  commissionBps          Int               @default(0)
  commissionMinor        BigInt            @default(0)
  sellerNetMinor         BigInt            @default(0)
  fulfillmentType        FulfillmentType
  shippingRateId         String?
  pickupPointId          String?
  shippingZoneName       String?
  shippingRateName       String?
  shippingRatePriceMinor BigInt?
  pickupPointName        String?
  pickupPointAddress     String?
  recipientName          String?
  recipientPhone         String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  province               String?
  postalCode             String?
  carrier                String?
  trackingCode           String?
  autoCompleteAt         DateTime?
  completedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  order                  Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  affiliate              Affiliate?        @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  reservations           InventoryReservation[]
  statusHistory          SellerOrderHistory[]
  ledgerEntries          AffiliateLedgerEntry[]
  issues                 AffiliateIssue[]
  cancellationRequests   AffiliateCancellationRequest[]
  refunds                RefundRecord[]
  notifications          Notification[]

  @@index([orderId, status])
  @@index([affiliateId, status, updatedAt])
  @@index([status, autoCompleteAt])
}

model SellerOrderHistory {
  id            String            @id @default(uuid())
  sellerOrderId String
  fromStatus    SellerOrderStatus?
  toStatus      SellerOrderStatus
  note          String?
  changedByType String?
  changedById   String?
  createdAt     DateTime          @default(now())
  sellerOrder   SellerOrder       @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  @@index([sellerOrderId, createdAt])
}

model AffiliateIssue {
  id              String              @id @default(uuid())
  sellerOrderId   String
  affiliateId     String
  openedByUserId  String
  status          AffiliateIssueStatus @default(OPEN)
  previousStatus  SellerOrderStatus
  previousAutoCompleteAt DateTime?
  reason          String
  resolutionNote  String?
  resolvedById    String?
  createdAt       DateTime            @default(now())
  resolvedAt      DateTime?
  version         Int                 @default(1)
  sellerOrder     SellerOrder         @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  affiliate       Affiliate           @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  openedBy        User                @relation(fields: [openedByUserId], references: [id], onDelete: Restrict)
  resolvedBy      Admin?              @relation("AffiliateIssueResolutions", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([affiliateId, status, createdAt])
  @@index([sellerOrderId, status])
}

model AffiliateLedgerEntry {
  id            String                  @id @default(uuid())
  affiliateId   String
  sellerOrderId String?
  payoutId      String?
  bucket        AffiliateLedgerBucket
  type          AffiliateLedgerType
  amountMinor   BigInt
  dedupeKey     String                @unique @default(uuid())
  note          String?
  createdAt     DateTime                @default(now())
  affiliate     Affiliate               @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  sellerOrder   SellerOrder?            @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  payout        AffiliatePayoutRequest? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId, bucket, createdAt])
  @@index([sellerOrderId, type])
  @@index([payoutId])
}

model AffiliatePayoutRequest {
  id                String                @id @default(uuid())
  affiliateId       String
  amountMinor       BigInt
  destinationCipher String?
  destinationLast4  String?
  status            AffiliatePayoutStatus @default(REQUESTED)
  externalReference String?
  note              String?
  version           Int                   @default(1)
  processedById     String?
  createdAt         DateTime              @default(now())
  processedAt       DateTime?
  affiliate         Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  processedBy       Admin?               @relation("AffiliatePayoutProcessors", fields: [processedById], references: [id], onDelete: SetNull)
  ledgerEntries     AffiliateLedgerEntry[]
  notifications     Notification[]

  @@index([affiliateId, status, createdAt])
}

model Payment {
  id                String              @id @default(uuid())
  orderId           String              @unique
  method            PaymentMethod
  status            PaymentStatus       @default(PENDING)
  amountMinor       BigInt
  currency          String              @default("USD")
  providerReference String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transfer          BankTransfer?
  mercadoPago       MercadoPagoPayment?
  refunds           RefundRecord[]
  webhookEvents     WebhookEvent[]

  @@index([status, updatedAt])
  @@index([method, status, updatedAt])
}

model BankTransfer {
  id           String               @id @default(uuid())
  paymentId    String               @unique
  reference    String               @unique
  reviewStatus TransferReviewStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  payment      Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reviewedBy   Admin?               @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reviewStatus, reviewedAt])
}

model TransferReceipt {
  id           String               @id @default(uuid())
  orderId      String
  fileId       String               @unique
  review       TransferReviewStatus @default(PENDING)
  note         String?
  createdAt    DateTime             @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  file         StoredFile           @relation(fields: [fileId], references: [id], onDelete: Restrict)
  reviewedBy   Admin?               @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([review, createdAt])
}

model MercadoPagoPayment {
  id                      String                    @id @default(uuid())
  paymentId               String                    @unique
  // Preserve the legacy default for rows created by old Preference-based code.
  // New Orders API rows set ORDER_V1 explicitly in the application transaction.
  integrationMode         MercadoPagoIntegrationMode @default(PREFERENCE_V1)
  preferenceId            String?
  providerOrderId         String?                   @unique
  providerIdempotencyKey  String?                   @unique
  externalPaymentId       String?                   @unique
  status                  String?
  statusDetail            String?
  checkoutUrl             String?
  providerAmountMinor     BigInt?
  providerCurrency        String?
  exchangeRateSnapshotId  String?
  expiresAt               DateTime?
  payment                 Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  exchangeRateSnapshot    ExchangeRateSnapshot?   @relation(fields: [exchangeRateSnapshotId], references: [id], onDelete: SetNull)
  attempts                MercadoPagoPaymentAttempt[]

  @@index([providerOrderId])
  @@index([status, expiresAt])
}

model ExchangeRateSnapshot {
  id                String   @id @default(uuid())
  source            String
  baseCurrency      String
  quoteCurrency     String
  sellRateMicros    BigInt
  providerUpdatedAt DateTime?
  fetchedAt         DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  mercadoPayments   MercadoPagoPayment[]

  @@index([source, baseCurrency, quoteCurrency, fetchedAt])
  @@index([expiresAt])
}

model MercadoPagoPaymentAttempt {
  id                    String              @id @default(uuid())
  mercadoPagoPaymentId  String
  providerPaymentId     String?             @unique
  attemptNumber         Int
  status                String
  statusDetail          String?
  amountMinor           BigInt?
  refundedAmountMinor   BigInt?
  currency              String?
  payload               String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  mercadoPagoPayment    MercadoPagoPayment  @relation(fields: [mercadoPagoPaymentId], references: [id], onDelete: Cascade)

  @@unique([mercadoPagoPaymentId, attemptNumber])
  @@index([status, updatedAt])
}

model WebhookEvent {
  id                String    @id @default(uuid())
  provider          String
  externalKey       String
  notificationId    String?   @unique
  resourceId        String?
  paymentId         String?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?
  attemptCount      Int       @default(0)
  nextAttemptAt     DateTime?
  lockedAt          DateTime?
  lastError         String?
  failedAt          DateTime?
  updatedAt         DateTime  @updatedAt
  payload           String
  payment           Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalKey])
  @@index([processedAt, nextAttemptAt])
  @@index([resourceId, processedAt])
}

model RefundRecord {
  id                String   @id @default(uuid())
  paymentId         String
  sellerOrderId     String?
  fullRefundKey     String?  @unique
  amountMinor       BigInt
  subtotalMinor     BigInt?
  shippingMinor     BigInt?
  commissionReversedMinor BigInt?
  sellerDebitMinor  BigInt?
  restocked         Boolean  @default(false)
  currency          String   @default("USD")
  reason            String
  externalReference String
  createdAt         DateTime @default(now())
  createdById       String
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  sellerOrder        SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  createdBy         Admin    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  refundLines       RefundLine[]

  @@index([sellerOrderId, createdAt])
}

model AffiliateCancellationRequest {
  id                    String                       @id @default(uuid())
  sellerOrderId         String
  affiliateId           String
  previousStatus        SellerOrderStatus
  previousAutoCompleteAt DateTime?
  status                AffiliateCancellationStatus @default(REQUESTED)
  reason                String
  resolutionNote        String?
  resolvedById          String?
  version               Int                          @default(1)
  createdAt             DateTime                     @default(now())
  resolvedAt            DateTime?
  sellerOrder           SellerOrder                  @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  affiliate             Affiliate                    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  resolvedBy            Admin?                       @relation("AffiliateCancellationResolutions", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([affiliateId, status, createdAt])
  @@index([sellerOrderId, status])
}

model RefundLine {
  id             String       @id @default(uuid())
  refundRecordId String
  orderItemId    String
  quantity       Int
  amountMinor    BigInt
  restocked      Boolean      @default(false)
  refundRecord   RefundRecord @relation(fields: [refundRecordId], references: [id], onDelete: Cascade)
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([refundRecordId])
  @@index([orderItemId])
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdAt   DateTime     @default(now())
  changedById String?
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   Admin?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model InventoryAdjustment {
  id          String   @id @default(uuid())
  productId   String
  delta       Int
  reason      String
  createdAt   DateTime @default(now())
  createdById String?
  affiliateId String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy   Admin?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  @@index([affiliateId, createdAt])
}

model StoredFile {
  id              String           @id @default(uuid())
  storageKey      String           @unique
  originalName    String?
  mimeType        String
  sizeBytes       Int
  sha256          String
  visibility      FileVisibility
  createdAt       DateTime         @default(now())
  productImage    ProductImage?
  transferReceipt TransferReceipt?
  newsCover       NewsItem?
}

model NewsItem {
  id           String      @id @default(uuid())
  title        String
  summary      String
  coverFileId  String?     @unique
  sortOrder    Int         @default(0)
  active       Boolean     @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  coverFile    StoredFile? @relation(fields: [coverFileId], references: [id], onDelete: Restrict)

  @@index([active, sortOrder, startsAt, endsAt])
}

model FileCleanupJob {
  id          String            @id @default(uuid())
  fileId      String            @unique
  storageKey  String
  status      FileCleanupStatus @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now())
  claimedAt   DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, availableAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([requestId, createdAt])
  @@index([action, createdAt])
}

model OutboxMessage {
  id          String       @id @default(uuid())
  type        String
  payload     String
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  processedAt DateTime?
  lastError   String?
  userId      String?
  orderId     String?
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
}

model SupportConversation {
  id                 String                    @id @default(uuid())
  userId             String
  subject            String
  status             SupportConversationStatus @default(OPEN)
  createdByType      SupportActorType
  createdById        String
  createdByName      String
  lastMessageAt      DateTime                  @default(now())
  lastMessagePreview String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           SupportMessage[]
  reads              SupportConversationRead[]
  notifications      Notification[]

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
}

model Notification {
  id                   String                   @id @default(uuid())
  recipientType        NotificationRecipientType
  userId               String?
  adminId              String?
  type                 NotificationType
  title                String
  message              String
  dedupeKey            String                   @unique
  orderId              String?
  sellerOrderId        String?
  affiliateListingId    String?
  payoutRequestId       String?
  supportConversationId String?
  readAt               DateTime?
  createdAt            DateTime                 @default(now())
  user                 User?                    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  admin                Admin?                   @relation("AdminNotifications", fields: [adminId], references: [id], onDelete: Cascade)
  order                Order?                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder          SellerOrder?             @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  affiliateListing     AffiliateListing?       @relation(fields: [affiliateListingId], references: [id], onDelete: Cascade)
  payoutRequest        AffiliatePayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  supportConversation SupportConversation?     @relation(fields: [supportConversationId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([adminId, readAt, createdAt])
  @@index([orderId, createdAt])
  @@index([sellerOrderId, createdAt])
  @@index([affiliateListingId, createdAt])
  @@index([payoutRequestId, createdAt])
  @@index([supportConversationId, createdAt])
}

model SupportMessage {
  id              String              @id @default(uuid())
  conversationId  String
  senderType      SupportActorType
  senderId        String
  senderName      String
  content         String
  clientMessageId String?             @unique
  isInitial       Boolean             @default(false)
  createdAt       DateTime            @default(now())
  conversation    SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, isInitial])
  @@index([senderType, senderId, createdAt])
}

model SupportConversationRead {
  id             String              @id @default(uuid())
  conversationId String
  actorType      SupportActorType
  actorId        String
  lastReadAt     DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, actorType, actorId])
  @@index([actorType, actorId, lastReadAt])
}
