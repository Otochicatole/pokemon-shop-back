generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductKind {
  SINGLE_CARD
  SEALED_PRODUCT
}

enum StockMode {
  UNIQUE
  QUANTITY
}

enum ProductCondition {
  NM
  EXCELLENT
  GOOD
  PLAYED
  DAMAGED
}

enum FulfillmentType {
  SHIPMENT
  PICKUP
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  COMPLETED
  CANCELLED
  EXPIRED
  REFUND_RECORDED
  PAYMENT_REQUIRES_REVIEW
}

enum PaymentMethod {
  BANK_TRANSFER
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  FAILED
  REFUNDED
  DISPUTED
  REQUIRES_REVIEW
}

enum TransferReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  name              String?
  passwordHash      String?
  status            UserStatus          @default(ACTIVE)
  emailVerifiedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  oauthAccounts     UserOAuthAccount[]
  sessions          UserSession[]
  tokens            UserToken[]
  orders            Order[]
  outboxMessages    OutboxMessage[]
}

model UserOAuthAccount {
  id           String   @id @default(uuid())
  userId       String
  issuer       String
  subject      String
  emailAtLogin String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  tokenHash    String   @unique
  csrfHash     String
  expiresAt    DateTime
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  revokedAt    DateTime?
  userAgent    String?
  ipHash       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model UserToken {
  id         String        @id @default(uuid())
  userId     String
  type       UserTokenType
  tokenHash  String        @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Admin {
  id                String               @id @default(uuid())
  email             String               @unique
  name              String?
  passwordHash      String
  status            AdminStatus          @default(ACTIVE)
  totpSecretCipher  String?
  totpEnabledAt     DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          AdminSession[]
  recoveryCodes     AdminRecoveryCode[]
  productImages     ProductImage[]
  inventoryChanges  InventoryAdjustment[]
  orderHistory      OrderStatusHistory[]
  transferReviews   TransferReceipt[]
  refunds           RefundRecord[]
  bankTransfers     BankTransfer[]
}

model AdminSession {
  id         String   @id @default(uuid())
  adminId    String
  tokenHash  String   @unique
  csrfHash   String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ipHash     String?
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt])
  @@index([expiresAt])
}

model AdminRecoveryCode {
  id         String    @id @default(uuid())
  adminId    String
  codeHash   String
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, usedAt])
}

model Product {
  id              String             @id @default(uuid())
  sku             String             @unique
  slug            String             @unique
  name            String
  description     String
  kind            ProductKind
  stockMode       StockMode
  priceMinor      BigInt
  currency        String             @default("ARS")
  status          ProductStatus      @default(DRAFT)
  version         Int                @default(1)
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  pokemonCard     PokemonCardDetails?
  inventory       Inventory?
  images          ProductImage[]
  orderItems      OrderItem[]
  inventoryLogs   InventoryAdjustment[]
  reservations    InventoryReservation[]

  @@index([status, kind])
  @@index([updatedAt])
}

model PokemonCardDetails {
  id                  String            @id @default(uuid())
  productId           String            @unique
  setName             String
  setCode             String?
  cardNumber          String
  rarity              String
  language            String
  condition           ProductCondition
  finish              String?
  edition             String?
  gradingCompany      String?
  grade               String?
  certificationNumber String?
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([setName, cardNumber])
  @@index([rarity, condition])
}

model Inventory {
  id        String   @id @default(uuid())
  productId String   @unique
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  version   Int      @default(1)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id          String       @id @default(uuid())
  productId   String
  fileId      String       @unique
  altText     String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  createdById String?
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  file        StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy   Admin?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

model ShippingZone {
  id          String                 @id @default(uuid())
  name        String
  active      Boolean                @default(true)
  provinces   ShippingZoneProvince[]
  rates       ShippingRate[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model ShippingZoneProvince {
  id       String       @id @default(uuid())
  zoneId   String
  province String
  zone     ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, province])
  @@index([province])
}

model ShippingRate {
  id          String       @id @default(uuid())
  zoneId      String
  name        String
  priceMinor  BigInt
  currency    String       @default("ARS")
  active      Boolean      @default(true)
  zone        ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, active])
}

model PickupPoint {
  id         String   @id @default(uuid())
  name       String
  address    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                 String                 @id @default(uuid())
  userId             String
  number             String                 @unique
  status             OrderStatus            @default(PENDING_PAYMENT)
  paymentMethod      PaymentMethod
  fulfillmentType    FulfillmentType
  currency           String                 @default("ARS")
  subtotalMinor     BigInt
  shippingMinor     BigInt
  totalMinor        BigInt
  shippingRateId    String?
  pickupPointId     String?
  recipientName     String?
  recipientPhone    String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  province          String?
  postalCode        String?
  idempotencyKey    String
  idempotencyHash   String
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  reservations      InventoryReservation[]
  payment           Payment?
  statusHistory     OrderStatusHistory[]
  transferReceipts  TransferReceipt[]
  outboxMessages    OutboxMessage[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  productId          String
  sku                String
  productName        String
  productSnapshot    String
  unitPriceMinor     BigInt
  quantity           Int
  lineTotalMinor     BigInt
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model InventoryReservation {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  expiresAt   DateTime
  releasedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([expiresAt, releasedAt, consumedAt])
}

model Payment {
  id                String              @id @default(uuid())
  orderId           String              @unique
  method            PaymentMethod
  status            PaymentStatus       @default(PENDING)
  amountMinor       BigInt
  currency          String              @default("ARS")
  providerReference String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transfer          BankTransfer?
  mercadoPago       MercadoPagoPayment?
  refunds           RefundRecord[]
  webhookEvents     WebhookEvent[]
}

model BankTransfer {
  id                 String   @id @default(uuid())
  paymentId          String   @unique
  reference          String   @unique
  reviewStatus       TransferReviewStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewedById       String?
  payment            Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reviewedBy         Admin?   @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
}

model TransferReceipt {
  id          String              @id @default(uuid())
  orderId     String
  fileId      String              @unique
  review      TransferReviewStatus @default(PENDING)
  note        String?
  createdAt   DateTime            @default(now())
  reviewedAt  DateTime?
  reviewedById String?
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  file        StoredFile          @relation(fields: [fileId], references: [id], onDelete: Restrict)
  reviewedBy  Admin?              @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model MercadoPagoPayment {
  id             String   @id @default(uuid())
  paymentId      String   @unique
  preferenceId   String?
  externalPaymentId String? @unique
  status         String?
  statusDetail   String?
  checkoutUrl    String?
  expiresAt      DateTime?
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id            String   @id @default(uuid())
  provider      String
  externalKey  String
  paymentId     String?
  receivedAt    DateTime @default(now())
  processedAt   DateTime?
  payload       String
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalKey])
  @@index([processedAt])
}

model RefundRecord {
  id              String   @id @default(uuid())
  paymentId       String
  amountMinor     BigInt
  currency        String   @default("ARS")
  reason          String
  externalReference String
  createdAt       DateTime @default(now())
  createdById     String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy       Admin    @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdAt   DateTime    @default(now())
  changedById String?
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   Admin?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model InventoryAdjustment {
  id          String   @id @default(uuid())
  productId   String
  delta       Int
  reason      String
  createdAt   DateTime @default(now())
  createdById String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy   Admin    @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

model StoredFile {
  id             String           @id @default(uuid())
  storageKey     String           @unique
  originalName   String?
  mimeType       String
  sizeBytes      Int
  sha256         String
  visibility     FileVisibility
  createdAt      DateTime         @default(now())
  productImage   ProductImage?
  transferReceipt TransferReceipt?
}

model AuditLog {
  id         String   @id @default(uuid())
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
}

model OutboxMessage {
  id          String       @id @default(uuid())
  type        String
  payload     String
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  processedAt DateTime?
  lastError   String?
  userId      String?
  orderId     String?
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, availableAt])
}
